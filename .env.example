# ──────────────────────────────────────────────────────
# Orderly — environment variable reference
# Copy to .env and fill in real values. Never commit .env
# ──────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
ADMIN_PORT=3001
LOG_LEVEL=info

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orders
DATABASE_POOL_SIZE=20

# Redis (required)
REDIS_URL=redis://localhost:6379

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Queue
QUEUE_PREFIX=orderly
QUEUE_MAX_STALLED_COUNT=2

# Outbox processor
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_RETRIES=5

# Webhooks
WEBHOOK_MAX_RETRIES=10
WEBHOOK_RETRY_BASE_DELAY_MS=1000
WEBHOOK_SECRET_HEADER=X-Webhook-Signature

# Payment gateway (required in non-dev)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_BASE_URL=https://api.stripe.com

# Circuit breaker
PAYMENT_CIRCUIT_BREAKER_THRESHOLD=5
PAYMENT_CIRCUIT_BREAKER_DURATION_MS=10000

# Admin API  ← MUST be overridden in production
ADMIN_API_KEY=dev-admin-key

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
