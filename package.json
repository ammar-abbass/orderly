{
  "name": "orderly",
  "version": "1.0.0",
  "description": "Production-grade event-driven order service: saga pattern, transactional outbox, advisory locks, circuit breaker, and full observability",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts tests/integration",
    "test:e2e": "vitest run --config vitest.integration.config.ts tests/e2e",
    "test:chaos": "vitest run --config vitest.integration.config.ts tests/chaos",
    "test:all": "pnpm run test:coverage && pnpm run test:integration",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/infrastructure/database/migration-runner.ts",
    "seed": "tsx scripts/seed-data.ts",
    "load-test": "bash scripts/load-test.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "bullmq": "^5.40.0",
    "cockatiel": "^3.2.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "postgres": "^3.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.1.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "ssh2"
    ]
  }
}