# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Orderly — Production Dockerfile
#
# Three-stage build:
#   1. deps    — install production dependencies only
#   2. build   — compile TypeScript to dist/
#   3. runtime — minimal image: prod deps + compiled output
#
# Security:
#   - Runs as non-root user `node`
#   - Base image pinned to exact digest for reproducibility
#   - No dev dependencies in the final image
#   - wget added for HEALTHCHECK (curl intentionally excluded for smaller attack surface)
# ─────────────────────────────────────────────────────────────────────────────

# Pin to a specific digest for reproducible production builds.
# Update periodically after security review.
# To find the current digest: docker pull node:24-alpine && docker inspect node:24-alpine --format '{{index .RepoDigests 0}}'
FROM node:24-alpine@sha256:2bdb65ed1dab192432bc31c95f94155ca5ad7fc1392fb7eb7526ab682fa5bf14 AS base
RUN corepack enable && corepack prepare pnpm@11.1.3 --activate
WORKDIR /app

# ── Stage 1: production dependencies ─────────────────────────────────────────
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts --prod

# ── Stage 2: build ────────────────────────────────────────────────────────────
FROM base AS build
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN pnpm run build

# ── Stage 3: runtime ──────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# wget for healthcheck; no curl (smaller attack surface)
RUN apk add --no-cache wget

# Copy prod dependencies and compiled output only
COPY --from=deps  /app/node_modules ./node_modules
COPY --from=build /app/dist         ./dist
COPY --from=build /app/package.json ./
COPY migrations ./migrations

# Run as non-root
USER node

EXPOSE 3000 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "dist/index.js"]
